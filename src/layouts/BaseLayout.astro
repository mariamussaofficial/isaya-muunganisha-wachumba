---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Isaya Muunganisha Wachumba | Habari, Trends na Maisha',
  description = 'Isaya Muunganisha Wachumba ni online media ya habari, trends, social media, burudani na mambo yanayohusu maisha.',
  canonical,
  image = '/og-default.svg',
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
---
<!doctype html>
<html lang="sw">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Isaya Muunganisha Wachumba" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <slot name="head" />
    <style is:global>
      :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #111827; background: #fff; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      a { color: inherit; text-decoration: none; }
      .container { width: min(1180px, calc(100% - 32px)); margin-inline: auto; }
      .muted { color: #6b7280; }
      .skip-link { position: absolute; left: -9999px; }
      .skip-link:focus { left: 16px; top: 16px; z-index: 100; padding: 10px 14px; background: #fff; border: 1px solid #111827; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Ruka kwenye maudhui</a>
    <header>
      <div class="container" style="display:flex;align-items:center;justify-content:space-between;padding:18px 0;border-bottom:1px solid #e5e7eb;">
        <a href="/" style="font-weight:800;font-size:1.2rem;">ISAYA</a>
        <nav aria-label="Main navigation" style="display:flex;gap:18px;font-size:.92rem;">
          <a href="/news">Habari</a>
          <a href="/trends">Trends</a>
          <a href="/life">Maisha</a>
          <a href="/entertainment">Burudani</a>
          <a href="/social-media">Social Media</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer style="margin-top:64px;border-top:1px solid #e5e7eb;">
      <div class="container" style="padding:32px 0;display:grid;gap:16px;">
        <strong>Isaya Muunganisha Wachumba</strong>
        <div class="muted" style="display:flex;gap:16px;flex-wrap:wrap;">
          <a href="/about">Kuhusu Sisi</a>
          <a href="/contact">Mawasiliano</a>
          <a href="/editorial-policy">Editorial Policy</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
        <small class="muted">© {new Date().getFullYear()} Isaya Muunganisha Wachumba. Haki zote zimehifadhiwa.</small>
      </div>
    </footer>
  </body>
</html>
