---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kuhusu Isaya Muunganisha Wachumba">
  <div class="container" style="padding:56px 0;max-width:820px;">
    <p class="muted">ABOUT ISAYA</p>
    <h1>Isaya Muunganisha Wachumba</h1>
    <p style="font-size:1.15rem;line-height:1.8;">Isaya Muunganisha Wachumba ni online media inayochapisha habari, trends, social media stories, burudani na maudhui yanayohusu maisha.</p>
    <h2>Tunachofanya</h2>
    <p style="line-height:1.8;">Tunataka kuunganisha wasomaji na habari na conversations zinazogusa maisha yao, huku tukijenga publication yenye uwazi, uaminifu na mtazamo wa kisasa wa digital media.</p>
    <h2>Editorial identity</h2>
    <p style="line-height:1.8;">Tunaweka mkazo kwenye usahihi, uwazi wa vyanzo, context na kusahihisha makosa tunapoyagundua.</p>
  </div>
</BaseLayout>
