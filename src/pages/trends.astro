---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('news', ({ data }) => !data.draft && data.categorySlug === 'trends')).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Trends | Isaya Muunganisha Wachumba" description="Stories, conversations na topics zinazotrend Tanzania na kwenye social media.">
  <section class="container page"><p class="eyebrow">TRENDS</p><h1>Trends</h1><p class="intro">Stories, conversations na topics zinazovuma mtandaoni.</p><div class="grid">{articles.map((a)=><article><a href={`/news/${a.id}`}><img src={a.data.featuredImage} alt={a.data.featuredImageAlt} width="500" height="281" loading="lazy"/><small>{a.data.category}</small><h2>{a.data.title}</h2><p>{a.data.excerpt}</p><time datetime={a.data.publishedAt.toISOString()}>{new Date(a.data.publishedAt).toLocaleDateString('sw-TZ')}</time></a></article>)}</div></section>
  <style>.page{padding:55px 0}.eyebrow{font-size:.75rem;font-weight:900;color:#b91c1c;letter-spacing:.1em}.page h1{font-size:clamp(2.5rem,7vw,5rem);margin:4px 0}.intro{color:#64748b}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:35px}.grid article{border-top:3px solid #0f172a;padding-top:14px}.grid img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px}.grid small{display:block;color:#b91c1c;font-weight:900;font-size:.7rem;margin-top:12px}.grid h2{font-size:1.25rem;line-height:1.2;margin:6px 0}.grid p{color:#64748b;line-height:1.5}.grid time{color:#64748b;font-size:.75rem}@media(max-width:800px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.grid{grid-template-columns:1fr}}
  </style>
</BaseLayout>
