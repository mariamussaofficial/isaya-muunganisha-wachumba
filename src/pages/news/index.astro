---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Habari | Isaya Muunganisha Wachumba" description="Habari za Tanzania na duniani kutoka Isaya Muunganisha Wachumba.">
  <section class="container page-head"><p class="eyebrow">NEWSROOM</p><h1>Habari</h1><p>Habari na taarifa zinazogusa Tanzania, jamii na dunia.</p></section>
  <section class="container stories" aria-label="Makala zote">
    {articles.map((article) => <article class="story"><a href={`/news/${article.id}`}><img src={article.data.featuredImage} alt={article.data.featuredImageAlt} width="480" height="270" loading="lazy" /><div><small>{article.data.category}</small><h2>{article.data.title}</h2><p>{article.data.excerpt}</p><time datetime={article.data.publishedAt.toISOString()}>{new Date(article.data.publishedAt).toLocaleDateString('sw-TZ', { day:'numeric', month:'long', year:'numeric' })}</time></div></a></article>)}
  </section>
  <style>.page-head{padding:55px 0 35px}.eyebrow{font-size:.75rem;color:#b91c1c;font-weight:900;letter-spacing:.1em}.page-head h1{font-size:clamp(2.5rem,7vw,5rem);letter-spacing:-.05em;margin:5px 0}.page-head p:last-child{color:#64748b;font-size:1.1rem}.stories{max-width:900px}.story{border-top:1px solid #e2e8f0;padding:22px 0}.story>a{display:grid;grid-template-columns:300px 1fr;gap:22px}.story img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:14px}.story small{color:#b91c1c;font-weight:900;text-transform:uppercase;font-size:.72rem}.story h2{font-size:1.45rem;line-height:1.2;margin:7px 0}.story p{color:#64748b;line-height:1.6;margin:0 0 10px}.story time{font-size:.78rem;color:#64748b}@media(max-width:650px){.story>a{grid-template-columns:1fr}}
  </style>
</BaseLayout>
