---
import BaseLayout from '../layouts/BaseLayout.astro';

const stories = [
  { category: 'HABARI', title: 'Isaya Muunganisha Wachumba — Habari na matukio yanayogusa maisha yetu', excerpt: 'Jukwaa la habari, trends na maisha linalokua pamoja na jamii yetu.', href: '/news' },
  { category: 'TRENDS', title: 'Kinachotrend mtandaoni leo', excerpt: 'Tutaweka hapa stories, conversations na movements zinazovuma kwenye social media.', href: '/trends' },
  { category: 'MAISHA', title: 'Mambo ya maisha, mahusiano na jamii', excerpt: 'Maudhui yenye relevance kwa maisha ya kila siku.', href: '/life' },
];
---
<BaseLayout>
  <section class="container" style="padding:56px 0 32px;">
    <p class="muted" style="font-weight:700;letter-spacing:.08em;">ONLINE MEDIA • TANZANIA</p>
    <h1 style="font-size:clamp(2.4rem,7vw,5.5rem);line-height:.95;max-width:900px;margin:16px 0;">Habari. Trends. Maisha.</h1>
    <p style="font-size:1.15rem;line-height:1.7;max-width:680px;color:#4b5563;">Isaya Muunganisha Wachumba ni online media inayounganisha habari, trends, social media, burudani na mambo yanayohusu maisha.</p>
  </section>

  <section class="container" style="padding:24px 0 64px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;">
      {stories.map((story) => (
        <article style="border:1px solid #e5e7eb;border-radius:18px;padding:24px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between;">
          <div>
            <small style="font-weight:800;letter-spacing:.08em;">{story.category}</small>
            <h2 style="font-size:1.35rem;line-height:1.2;margin:12px 0;">{story.title}</h2>
            <p class="muted" style="line-height:1.6;">{story.excerpt}</p>
          </div>
          <a href={story.href} style="font-weight:700;">Soma zaidi →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="container" style="padding:0 0 64px;">
    <div style="border-radius:20px;background:#111827;color:white;padding:32px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center;">
      <div>
        <h2 style="margin:0 0 8px;font-size:1.8rem;">Karibu Isaya.</h2>
        <p style="margin:0;color:#d1d5db;">Website yetu inajengwa. Hii ndiyo foundation ya newsroom yetu ya digital.</p>
      </div>
      <a href="/about" style="background:white;color:#111827;padding:12px 18px;border-radius:999px;font-weight:700;">Kuhusu Isaya</a>
    </div>
  </section>
</BaseLayout>
