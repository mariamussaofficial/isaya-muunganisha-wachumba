---
import BaseLayout from '../layouts/BaseLayout.astro';

const latest = [
  { category: 'HABARI', title: 'Habari muhimu zinazogusa Tanzania na jamii', excerpt: 'Tunafuatilia matukio, taarifa na stories zenye relevance kwa wasomaji wetu.', href: '/news' },
  { category: 'TRENDS', title: 'Kinachozungumzwa zaidi kwenye mitandao', excerpt: 'Conversations, creators, movements na moments zinazovuma kwenye social media.', href: '/trends' },
  { category: 'MAISHA', title: 'Mahusiano, lifestyle na maisha ya kila siku', excerpt: 'Stories na insights zinazogusa namna tunavyoishi, kupenda na kuungana.', href: '/life' },
];

const sections = [
  ['Habari', '/news', 'Taarifa na matukio'],
  ['Trends', '/trends', 'Kinachovuma sasa'],
  ['Maisha', '/life', 'Lifestyle na mahusiano'],
  ['Burudani', '/entertainment', 'Wasanii na entertainment'],
  ['Social Media', '/social-media', 'Internet culture na creators'],
];
---
<BaseLayout title="Isaya Muunganisha Wachumba | Habari, Trends, Maisha na Social Media" description="Isaya Muunganisha Wachumba ni online media ya Tanzania inayochapisha habari, trends, social media, burudani na mambo yanayohusu maisha.">
  <section class="container" style="padding:48px 0 30px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div>
        <p class="muted" style="font-weight:800;letter-spacing:.1em;font-size:.78rem;margin:0 0 10px;">ONLINE MEDIA • TANZANIA</p>
        <h1 style="font-size:clamp(2.5rem,7vw,5.6rem);line-height:.9;letter-spacing:-.06em;max-width:850px;margin:0;">Habari.<br />Trends.<br />Maisha.</h1>
      </div>
      <div style="max-width:340px;border-left:3px solid #0f172a;padding-left:18px;">
        <p style="font-size:1.05rem;line-height:1.7;margin:0;">Stories zinazotokea, conversations zinazotrend na mambo yanayogusa maisha yetu.</p>
      </div>
    </div>
  </section>

  <section class="container" style="padding:18px 0 56px;">
    <div style="display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.75fr);gap:18px;">
      <a href="/news" style="display:block;background:#e2e8f0;min-height:360px;border-radius:20px;padding:28px;position:relative;overflow:hidden;">
        <div style="position:absolute;inset:0;background:linear-gradient(145deg,transparent 25%,rgba(15,23,42,.2));"></div>
        <div style="position:relative;display:flex;flex-direction:column;justify-content:flex-end;height:100%;max-width:700px;">
          <span style="display:inline-block;background:#0f172a;color:#fff;border-radius:999px;padding:6px 10px;font-size:.72rem;font-weight:800;width:max-content;">HABARI KUU</span>
          <h2 style="font-size:clamp(2rem,4vw,3.5rem);line-height:1.02;letter-spacing:-.04em;margin:14px 0 8px;">Newsroom ya kisasa, iliyojengwa kwa ajili ya kizazi cha social media.</h2>
          <p style="margin:0;line-height:1.6;max-width:620px;">Karibu Isaya Muunganisha Wachumba — chanzo cha habari, trends na stories za maisha.</p>
        </div>
      </a>
      <div style="display:grid;gap:18px;">
        {latest.slice(1).map((story) => (
          <a href={story.href} style="border:1px solid #e2e8f0;border-radius:20px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;min-height:171px;">
            <div><small style="font-weight:900;letter-spacing:.08em;">{story.category}</small><h3 style="font-size:1.35rem;line-height:1.15;margin:10px 0;">{story.title}</h3></div>
            <span style="font-weight:800;font-size:.9rem;">Soma zaidi →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;">
    <div class="container" style="display:flex;gap:24px;overflow-x:auto;white-space:nowrap;padding:14px 0;font-weight:800;font-size:.9rem;">
      {sections.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>
  </section>

  <section class="container" style="padding:56px 0;">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:22px;">
      <div><p class="muted" style="margin:0 0 6px;font-weight:800;font-size:.78rem;letter-spacing:.08em;">LATEST</p><h2 style="font-size:2rem;letter-spacing:-.03em;margin:0;">Latest Stories</h2></div>
      <a href="/news" style="font-weight:800;">Tazama zote →</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;">
      {latest.map((story) => (
        <article style="border-top:3px solid #0f172a;padding-top:16px;">
          <small style="font-weight:900;letter-spacing:.08em;">{story.category}</small>
          <h3 style="font-size:1.35rem;line-height:1.18;margin:10px 0;">{story.title}</h3>
          <p class="muted" style="line-height:1.65;margin:0 0 18px;">{story.excerpt}</p>
          <a href={story.href} style="font-weight:800;font-size:.9rem;">Soma zaidi →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="container" style="padding:0 0 56px;">
    <div style="background:#0f172a;color:#fff;border-radius:22px;padding:30px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;">
      <div><p style="margin:0 0 6px;color:#94a3b8;font-size:.78rem;font-weight:800;letter-spacing:.08em;">FOLLOW ISAYA</p><h2 style="margin:0;font-size:1.8rem;">Habari zinaendelea kwenye social media.</h2></div>
      <a href="/social-media" style="background:#fff;color:#0f172a;border-radius:999px;padding:12px 18px;font-weight:800;">Tufuate →</a>
    </div>
  </section>
</BaseLayout>
