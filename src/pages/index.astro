---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [hero, ...latest] = articles;
const sections = [['Habari','/news'],['Trends','/trends'],['Maisha','/life'],['Burudani','/entertainment'],['Social Media','/social-media']];
---
<BaseLayout title="Isaya Muunganisha Wachumba | Habari, Trends, Maisha na Social Media" description="Isaya Muunganisha Wachumba ni online media ya Tanzania inayochapisha habari, trends, social media, burudani na mambo yanayohusu maisha.">
  <section class="container intro"><div><p class="eyebrow">ONLINE MEDIA • TANZANIA</p><h1>Habari.<br />Trends.<br />Maisha.</h1></div><p class="mission">Stories zinazotokea, conversations zinazotrend na mambo yanayogusa maisha yetu.</p></section>
  {hero && <section class="container hero-grid"><a class="hero" href={`/news/${hero.id}`}><img src={hero.data.featuredImage} alt={hero.data.featuredImageAlt} width="1200" height="675" loading="eager" decoding="async" /><div class="hero-overlay"><span>{hero.data.category}</span><h2>{hero.data.title}</h2><p>{hero.data.excerpt}</p></div></a><div class="side-stories">{latest.slice(0,2).map((story) => <a href={`/news/${story.id}`}><small>{story.data.category}</small><h3>{story.data.title}</h3><time datetime={story.data.publishedAt.toISOString()}>{new Date(story.data.publishedAt).toLocaleDateString('sw-TZ')}</time></a>)}</div></section>}
  <section class="ticker"><div class="container ticker-inner">{sections.map(([label, href]) => <a href={href}>{label}</a>)}</div></section>
  <section class="container latest"><div class="section-head"><div><p class="eyebrow">LATEST</p><h2>Latest Stories</h2></div><a href="/news">Tazama zote →</a></div><div class="story-grid">{articles.slice(0,6).map((story) => <article><a href={`/news/${story.id}`}><img src={story.data.featuredImage} alt={story.data.featuredImageAlt} width="500" height="281" loading="lazy" /><div><small>{story.data.category}</small><h3>{story.data.title}</h3><p>{story.data.excerpt}</p><time datetime={story.data.publishedAt.toISOString()}>{new Date(story.data.publishedAt).toLocaleDateString('sw-TZ')}</time></div></a></article>)}</div></section>
  <section class="container follow"><div><p>FOLLOW ISAYA</p><h2>Habari zinaendelea kwenye social media.</h2></div><a href="/social-media">Tufuate →</a></section>
  <style>.intro{padding:48px 0 30px;display:flex;align-items:end;justify-content:space-between;gap:24px}.eyebrow{color:#64748b;font-weight:900;letter-spacing:.1em;font-size:.76rem;margin:0 0 9px}.intro h1{font-size:clamp(3rem,8vw,6.5rem);line-height:.88;letter-spacing:-.065em;margin:0}.mission{max-width:340px;border-left:3px solid #0f172a;padding-left:18px;line-height:1.7;margin:0 0 4px}.hero-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,.7fr);gap:18px;padding-bottom:48px}.hero{position:relative;display:block;min-height:520px;border-radius:20px;overflow:hidden;background:#e2e8f0}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-overlay{position:absolute;inset:0;padding:28px;display:flex;flex-direction:column;justify-content:end;background:linear-gradient(transparent 20%,rgba(15,23,42,.9));color:#fff}.hero-overlay span,.side-stories small,.story-grid small{font-weight:900;letter-spacing:.08em;text-transform:uppercase;font-size:.72rem}.hero-overlay h2{font-size:clamp(2rem,4vw,3.8rem);line-height:1.02;letter-spacing:-.04em;margin:10px 0}.hero-overlay p{max-width:680px;line-height:1.6;margin:0}.side-stories{display:grid;gap:18px}.side-stories a{border:1px solid #e2e8f0;border-radius:20px;padding:24px;display:flex;flex-direction:column;justify-content:center}.side-stories h3{font-size:1.35rem;line-height:1.18;margin:10px 0}.side-stories time,.story-grid time{color:#64748b;font-size:.76rem}.ticker{border-block:1px solid #e2e8f0}.ticker-inner{display:flex;gap:26px;overflow:auto;white-space:nowrap;padding:14px 0;font-weight:800}.latest{padding:56px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:22px}.section-head h2{font-size:2rem;letter-spacing:-.03em;margin:0}.section-head>a{font-weight:800}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.story-grid article{border-top:3px solid #0f172a;padding-top:15px}.story-grid img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px}.story-grid h3{font-size:1.25rem;line-height:1.2;margin:8px 0}.story-grid p{color:#64748b;line-height:1.55;margin:0 0 10px}.follow{margin-bottom:56px;background:#0f172a;color:#fff;border-radius:22px;padding:30px;display:flex;justify-content:space-between;align-items:center;gap:24px}.follow p{color:#94a3b8;font-size:.76rem;font-weight:900;letter-spacing:.1em;margin:0 0 5px}.follow h2{margin:0;font-size:1.8rem}.follow a{background:#fff;color:#0f172a;border-radius:999px;padding:12px 18px;font-weight:800}@media(max-width:750px){.intro{display:block}.mission{margin-top:24px}.hero-grid{grid-template-columns:1fr}.hero{min-height:440px}.story-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.story-grid{grid-template-columns:1fr}.follow{display:block}.follow a{display:inline-block;margin-top:18px}}
  </style>
</BaseLayout>
